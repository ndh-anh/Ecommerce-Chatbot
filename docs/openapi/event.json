        "maxLength": 2048,
        "format": "uri"
      },
      "EventInput": {
        "type": "object",
        "required": [
          "title",
          "slug",
          "thumbnailUrl",
          "description",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "title": {
            "$ref": "#/components/schemas/EventTitle"
          },
          "slug": {
            "$ref": "#/components/schemas/EventSlug"
          },
          "thumbnailUrl": {
            "$ref": "#/components/schemas/EventImageUrl"
          },
          "description": {
            "type": "string",
            "maxLength": 100000
          },
          "summary": {
            "type": "string",
            "maxLength": 500
          },
          "startsAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "endsAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "isPublished": {
            "type": "boolean",
            "default": false
          },
          "showOnCarousel": {
            "type": "boolean",
            "default": true
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "default": 0
          }
        }
      },
      "EventList": {
        "type": "object",
        "required": [
          "totalCount",
          "totalPages",
          "events"
        ],
        "properties": {
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventSummary"
            }
          }
        }
      },
      "EventPatch": {
        "type": "object",
        "properties": {
