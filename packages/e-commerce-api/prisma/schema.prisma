generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model addresses {
  id            String   @id @db.Uuid
  user_id       String   @db.Uuid
  receiver_name String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address_line  String?
  city          String?  @db.VarChar(255)
  country       String?  @db.VarChar(100)
  is_default    Boolean? @default(false)
  users         users    @relation(fields: [user_id], references: [uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_addresses_user")
}

model cart_items {
  cart_id            String           @db.Uuid
  product_variant_id String           @db.Uuid
  quantity           Int?             @default(1)
  carts              carts            @relation(fields: [cart_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_cart")
  product_variants   product_variants @relation(fields: [product_variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_variant")

  @@id([cart_id, product_variant_id], map: "pk_cart_items")
}

model carts {
  id         String       @id @db.Uuid
  user_id    String       @unique @db.Uuid
  updated_at DateTime?    @db.Timestamp(6)
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_carts_user")
}

model categories {
  id               String       @id @db.Uuid
  name             String       @unique(map: "uq_categories_name") @db.VarChar(255)
  parent_id        String?      @db.Uuid
  slug             String       @unique(map: "uq_categories_slug") @db.VarChar(100)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categories_parent")
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model databasechangelog {
  id            String   @db.VarChar(255)
  author        String   @db.VarChar(255)
  filename      String   @db.VarChar(255)
  dateexecuted  DateTime @db.Timestamp(6)
  orderexecuted Int
  exectype      String   @db.VarChar(10)
  md5sum        String?  @db.VarChar(35)
  description   String?  @db.VarChar(255)
  comments      String?  @db.VarChar(255)
  tag           String?  @db.VarChar(255)
  liquibase     String?  @db.VarChar(20)
  contexts      String?  @db.VarChar(255)
  labels        String?  @db.VarChar(255)
  deployment_id String?  @db.VarChar(10)

  @@ignore
}

model databasechangeloglock {
  id          Int       @id
  locked      Boolean
  lockgranted DateTime? @db.Timestamp(6)
  lockedby    String?   @db.VarChar(255)

  @@ignore
}

model flash_sales {
  id         String    @id @db.Uuid
  name       String?   @db.VarChar(255)
  start_time DateTime? @db.Timestamp(6)
  end_time   DateTime? @db.Timestamp(6)

  @@index([start_time, end_time], map: "idx_flash_sales_time_range")
}

model groups {
  gid          String        @id @db.Uuid
  group_name   String        @unique @db.VarChar(255)
  parent_gid   String?       @db.Uuid
  created_at   DateTime?     @db.Timestamp(6)
  updated_at   DateTime?     @db.Timestamp(6)
  is_deleted   Boolean?      @default(false)
  group_roles  group_roles[]
  groups       groups?       @relation("groupsTogroups", fields: [parent_gid], references: [gid], onDelete: NoAction, onUpdate: NoAction, map: "fk_groups_parent")
  other_groups groups[]      @relation("groupsTogroups")
  user_groups  user_groups[]
}

model order_items {
  id                 String   @id @db.Uuid
  order_id           String   @db.Uuid
  product_id         String?  @db.Uuid
  product_variant_id String?  @db.Uuid
  product_name       String?  @db.VarChar(500)
  variant_name       String?  @db.VarChar(500)
  price              Decimal? @db.Decimal(18, 2)
  quantity           Int?
  total_price        Decimal? @db.Decimal(18, 2)
  orders             orders   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_items_order")

  @@index([order_id], map: "idx_order_items_order_id")
}

model order_vouchers {
  id              String   @id @db.Uuid
  order_id        String   @db.Uuid
  voucher_id      String   @db.Uuid
  discount_amount Decimal? @db.Decimal(18, 2)
  orders          orders   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_vouchers_order")
  vouchers        vouchers @relation(fields: [voucher_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_vouchers_voucher")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model orders {
  id             String           @id @db.Uuid
  user_id        String           @db.Uuid
  status         String?          @db.VarChar(50)
  total_amount   Decimal?         @db.Decimal(18, 2)
  total_discount Decimal?         @default(0) @db.Decimal(18, 2)
  final_amount   Decimal?         @db.Decimal(18, 2)
  created_at     DateTime?        @db.Timestamp(6)
  order_items    order_items[]
  order_vouchers order_vouchers[]
  users          users            @relation(fields: [user_id], references: [uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_user")
  payments       payments[]

  @@index([created_at], map: "idx_orders_created_at")
  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user_id")
}

model payments {
  id         String    @id @db.Uuid
  order_id   String    @db.Uuid
  method     String?   @db.VarChar(100)
  status     String?   @db.VarChar(50)
  amount     Decimal?  @db.Decimal(18, 2)
  created_at DateTime? @db.Timestamp(6)
  orders     orders    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payments_order")

  @@index([order_id], map: "idx_payments_order_id")
  @@index([status], map: "idx_payments_status")
}

model permissions {
  pid              String             @id @db.Uuid
  code             String             @unique @db.VarChar(100)
  action           String             @db.VarChar(100)
  subject          String             @db.VarChar(100)
  role_permissions role_permissions[]

  @@unique([action, subject], map: "uq_permissions_action_subject")
}

model product_images {
  id           String    @id @db.Uuid
  product_id   String    @db.Uuid
  url          String?   @db.VarChar(500)
  is_thumbnail Boolean?  @default(false)
  sort_order   Int?      @default(0)
  created_at   DateTime? @db.Timestamp(6)
  products     products  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_images_product")

  @@index([product_id], map: "idx_product_images_product_id")
}

model product_variants {
  id                       String                     @id @db.Uuid
  product_id               String                     @db.Uuid
  sku                      String?                    @unique @db.VarChar(255)
  thumbnail_url            String?                    @db.VarChar(500)
  price                    Decimal?                   @db.Decimal(18, 2)
  compare_price            Decimal?                   @db.Decimal(18, 2)
  stock                    Int?                       @default(0)
  created_at               DateTime?                  @db.Timestamp(6)
  updated_at               DateTime?                  @db.Timestamp(6)
  cart_items               cart_items[]
  products                 products                   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_variants_product")
  variant_attribute_values variant_attribute_values[]
  warehouse_inventory      warehouse_inventory[]

  @@index([product_id], map: "idx_product_variants_product_id")
  @@index([sku], map: "idx_product_variants_sku")
}

model products {
  id                 String               @id @db.Uuid
  category_id        String?              @db.Uuid
  name               String               @db.VarChar(500)
  slug               String?              @db.VarChar(500)
  thumbnail_url      String?              @db.VarChar(500)
  description        String?
  is_published       Boolean?             @default(true)
  created_at         DateTime?            @db.Timestamp(6)
  updated_at         DateTime?            @db.Timestamp(6)
  brand_id           String?              @db.Uuid
  product_attributes product_attributes[]
  product_images     product_images[]
  product_variants   product_variants[]
  brands             brands?              @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_brand")
  categories         categories?          @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_category")
  reviews            reviews[]
  wishlist_items     wishlist_items[]

  @@index([category_id], map: "idx_products_category_id")
  @@index([brand_id], map: "idx_products_brand_id")
}

model reviews {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  rating     Int?
  comment    String?
  products   products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reviews_product")
  users      users    @relation(fields: [user_id], references: [uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_reviews_user")
}

model roles {
  role_id          String             @id @db.Uuid
  role_name        String             @unique @db.VarChar(255)
  group_roles      group_roles[]
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model user_groups {
  uid    String @db.Uuid
  gid    String @db.Uuid
  groups groups @relation(fields: [gid], references: [gid], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_groups_gid")
  users  users  @relation(fields: [uid], references: [uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_groups_uid")

  @@id([uid, gid], map: "pk_user_groups")
}

model users {
  uid                 String                @id @db.Uuid
  username            String                @unique @db.VarChar(255)
  email               String                @unique @db.VarChar(255)
  password            String                @db.VarChar(255)
  full_name           String?               @db.VarChar(255)
  phone               String?               @db.VarChar(50)
  is_active           Boolean?              @default(true)
  is_deleted          Boolean?              @default(false)
  last_login          DateTime?             @db.Timestamp(6)
  created_at          DateTime?             @db.Timestamp(6)
  updated_at          DateTime?             @db.Timestamp(6)
  is_email_verified   Boolean?              @default(false)
  addresses           addresses[]
  carts               carts?
  orders              orders[]
  reviews             reviews[]
  user_groups         user_groups[]
  user_roles          user_roles[]
  verification_tokens verification_tokens[]
  wishlists           wishlists[]
  google_account      google_accounts?

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model voucher_conditions {
  id         String   @id @db.Uuid
  voucher_id String   @db.Uuid
  type       String?  @db.VarChar(50)
  ref_id     String?  @db.Uuid
  vouchers   vouchers @relation(fields: [voucher_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_voucher_conditions_voucher")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model vouchers {
  id                 String               @id @db.Uuid
  code               String               @unique @db.VarChar(100)
  discount_type      String?              @db.VarChar(50)
  discount_value     Decimal?             @db.Decimal(18, 2)
  max_discount       Decimal?             @db.Decimal(18, 2)
  min_order_value    Decimal?             @db.Decimal(18, 2)
  usage_limit        Int?
  used_count         Int?                 @default(0)
  start_date         DateTime?            @db.Timestamp(6)
  end_date           DateTime?            @db.Timestamp(6)
  is_active          Boolean?             @default(true)
  order_vouchers     order_vouchers[]
  voucher_conditions voucher_conditions[]

  @@index([code], map: "idx_vouchers_code")
  @@index([is_active], map: "idx_vouchers_is_active")
}

model warehouse_inventory {
  warehouse_id       String           @db.Uuid
  product_variant_id String           @db.Uuid
  stock              Int?             @default(0)
  product_variants   product_variants @relation(fields: [product_variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_warehouse_inventory_variant")
  warehouses         warehouses       @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_warehouse_inventory_warehouse")

  @@id([warehouse_id, product_variant_id], map: "pk_warehouse_inventory")
  @@index([product_variant_id], map: "idx_warehouse_inventory_variant_id")
}

model warehouses {
  id                  String                @id @db.Uuid
  name                String?               @db.VarChar(255)
  address             String?
  created_at          DateTime?             @db.Timestamp(6)
  warehouse_inventory warehouse_inventory[]

  @@index([name], map: "idx_warehouses_name")
}

model wishlist_items {
  id          String    @id @db.Uuid
  wishlist_id String    @db.Uuid
  product_id  String    @db.Uuid
  products    products  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_wishlist_items_product")
  wishlists   wishlists @relation(fields: [wishlist_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_wishlist_items_wishlist")
}

model wishlists {
  id             String           @id @db.Uuid
  user_id        String           @db.Uuid
  wishlist_items wishlist_items[]
  users          users            @relation(fields: [user_id], references: [uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_wishlists_user")
}

model brands {
  id       String     @id @db.Uuid
  name     String     @unique(map: "uq_brands_name") @db.VarChar(100)
  slug     String     @unique(map: "uq_brands_slug") @db.VarChar(100)
  products products[]
}

model group_roles {
  gid     String @db.Uuid
  role_id String @db.Uuid
  groups  groups @relation(fields: [gid], references: [gid], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_role_gid")
  roles   roles  @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_role_role")

  @@id([gid, role_id], map: "pk_group_role")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [pid], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permissions_perm")
  roles         roles       @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id], map: "pk_role_permissions")
}

model user_roles {
  uid     String @db.Uuid
  role_id String @db.Uuid
  roles   roles  @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_roles_role")
  users   users  @relation(fields: [uid], references: [uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_roles_uid")

  @@id([uid, role_id], map: "pk_user_roles")
}

model file_stores {
  id         String   @id @db.Uuid
  filename   String   @unique(map: "uq_filename") @db.VarChar(255)
  key        String   @unique(map: "uq_key") @db.VarChar(255)
  upload_uid String   @db.Uuid
  upload_at  DateTime @default(now()) @db.Timestamptz(6)
}

model attributes {
  id                       String                     @id @db.Uuid
  name                     String                     @unique(map: "uq_attributes_name") @db.VarChar(100)
  product_attributes       product_attributes[]
  variant_attribute_values variant_attribute_values[]
}

model product_attributes {
  product_id   String     @db.Uuid
  attribute_id String     @db.Uuid
  sort_order   Int?       @default(0)
  attributes   attributes @relation(fields: [attribute_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_attributes_attribute")
  products     products   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_attributes_product")

  @@id([product_id, attribute_id], map: "pk_product_attributes")
  @@index([attribute_id], map: "idx_product_attributes_attribute_id")
}

model variant_attribute_values {
  product_variant_id String           @db.Uuid
  attribute_id       String           @db.Uuid
  value              String           @db.VarChar(255)
  attributes         attributes       @relation(fields: [attribute_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_attribute_values_attribute")
  product_variants   product_variants @relation(fields: [product_variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_attribute_values_variant")

  @@id([product_variant_id, attribute_id], map: "pk_variant_attribute_values")
  @@index([attribute_id], map: "idx_variant_attribute_values_attribute_id")
}

model verification_tokens {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [uid], onDelete: NoAction, onUpdate: NoAction, map: "fk_verification_tokens_user")
}

model outbox_events {
  id             String   @id @db.Uuid
  aggregate_type String   @db.VarChar(100)
  aggregate_id   String   @db.VarChar(255)
  event_type     String   @db.VarChar(100)
  payload        Json     @db.JsonB
  status         String   @default("PENDING") @db.VarChar(50)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  event_version  BigInt   @default(0)
  attempts       Int      @default(0)
  next_attempt_at DateTime @default(now()) @db.Timestamp(6)
  locked_until   DateTime? @db.Timestamp(6)
  lock_token     String? @db.Uuid
  last_error     String?
  processed_at   DateTime? @db.Timestamp(6)

  @@index([status, next_attempt_at, created_at, id], map: "idx_outbox_pending")
  @@index([status, locked_until], map: "idx_outbox_lease")
}

model product_event_versions {
  product_id String @id @db.Uuid
  version BigInt
}

model google_accounts {
  google_sub String @id @db.VarChar(255)
  user_id String @unique @db.Uuid
  users users @relation(fields: [user_id], references: [uid], onDelete: Cascade)
}

model events {
  id String @id @db.Uuid
  title String @db.VarChar(200)
  slug String @unique @db.VarChar(200)
  thumbnail_url String @db.VarChar(2048)
  description String @db.Text
  summary String @default("") @db.VarChar(500)
  starts_at DateTime @db.Timestamptz(6)
  ends_at DateTime @db.Timestamptz(6)
  is_published Boolean @default(false)
  show_on_carousel Boolean @default(true)
  sort_order Int @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([is_published, show_on_carousel, starts_at, ends_at], map: "idx_events_carousel")
}
