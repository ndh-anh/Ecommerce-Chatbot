          },
          "description": {
            "type": "string",
            "maxLength": 100000
          },
          "summary": {
            "type": "string",
            "maxLength": 500
          },
          "startsAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "endsAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "isPublished": {
            "type": "boolean"
          },
          "showOnCarousel": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "EventResponse": {
        "type": "object",
        "required": [
          "eventId",
          "title",
          "slug",
          "thumbnailUrl",
          "summary",
          "startsAt",
          "endsAt",
          "isPublished",
          "showOnCarousel",
          "sortOrder",
          "status",
          "description",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/UUID"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "startsAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "endsAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "isPublished": {
            "type": "boolean"
          },
          "showOnCarousel": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "upcoming",
              "active",
              "ended"
            ]
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/EventDateTime"
          }
        }
      },
      "EventSlug": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+){0,}$"
      },
      "EventSummary": {
        "type": "object",
        "required": [
          "eventId",
          "title",
          "slug",
          "thumbnailUrl",
          "summary",
          "startsAt",
          "endsAt",
          "isPublished",
          "showOnCarousel",
          "sortOrder",
          "status"
        ],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/UUID"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "startsAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "endsAt": {
            "$ref": "#/components/schemas/EventDateTime"
          },
          "isPublished": {
            "type": "boolean"
          },
          "showOnCarousel": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "upcoming",
              "active",
              "ended"
            ]
          }
        }
      },
      "EventTitle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "UUID": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    }
