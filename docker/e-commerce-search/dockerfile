ARG NODE_VERSION=22.17.0-slim

FROM node:${NODE_VERSION} AS builder

# Apply OS security patches and install certificates & protoc
RUN apt-get update && apt-get upgrade -y && apt-get install -y ca-certificates protobuf-compiler && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# Copy root configs
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy packages
COPY packages/ ./packages/

# Install project dependencies with frozen lockfile for reproducible builds
# Using cache mount for pnpm store to speed up installs
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

ENV NODE_ENV=production

# Generate protobuf types
RUN pnpm --filter proto generate

# Build the application
RUN pnpm --filter e-commerce-search build

# Deploy isolated production environment
RUN pnpm --filter e-commerce-search --prod deploy --legacy /app/out \
    && test -f /app/out/dist/server.js

# ============================================
# Stage 2: Run API application
# ============================================
FROM node:${NODE_VERSION} AS runner

# Apply OS security patches
RUN apt-get update && apt-get upgrade -y && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Set production environment variables
ENV NODE_ENV=production
ENV PORT=50053
ENV HOSTNAME="0.0.0.0"

COPY --from=builder --chown=node:node /app/out ./

# Switch to non-root user for security best practices
# We temporarily switch to root to remove the global npm installed by the base node image.
# This prevents Trivy from reporting vulnerabilities (e.g., in tar, glob, minimatch) 
# that exist within npm itself. Since we use pnpm for package management and 
# run the app with node directly, npm is entirely unnecessary in the production image.
USER root
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
USER node

# Expose port 50053 to allow gRPC traffic
EXPOSE 50053

# Start the application using the Node.js runtime
CMD ["node", "dist/server.js"]