# Copy to .env.production and replace all YOUR_* values.
# Always pass --env-file .env.production to Docker Compose.

# Docker Hub deployment (docker-compose.hub.yaml).
# All application images and the migration image must use the same release tag.
DOCKERHUB_NAMESPACE=YOUR_DOCKERHUB_USERNAME
IMAGE_TAG=v1.0.0

# Supabase: copy host/user/port from Connect (direct or session pooler).
DB_HOST=YOUR_SUPABASE_DB_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=YOUR_SUPABASE_DB_USER
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
PGSSLMODE=require
# AI checkpoints: URL-encode username/password when they contain special characters.
DB_URI=postgresql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_SUPABASE_DB_HOST:5432/postgres?sslmode=require

# Cloud RabbitMQ (TLS)
RABBITMQ_URL=amqps://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_RABBITMQ_HOST:5671/YOUR_VHOST

# Elasticsearch runs in Compose (512 MB RAM, 256 MB JVM heap).
# Compose sets this internal endpoint for the search service.
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# API
JWT_ACCESS_SECRET=YOUR_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=YOUR_RANDOM_REFRESH_SECRET
OTP_EXPIRATION_MINUTES=5
FRONTEND_URL=https://shop.example.com
API_PORT=8080
FRONTEND_PORT=80

# Browser-visible API URL: embedded at build time; rebuild frontend after changing it.
NEXT_PUBLIC_API_URL=https://api.example.com
# Server-side requests from the frontend container use the Compose API hostname.
API_URL=http://api:8080

# AWS S3 / CloudFront
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
S3_BUCKET_NAME=YOUR_S3_BUCKET_NAME
CLOUDFRONT_DOMAIN=YOUR_CLOUDFRONT_DOMAIN

# Email
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=sender@example.com

# Search embeddings and AI agents
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_API_KEY_AGENT_1=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_API_KEY_AGENT_2=YOUR_DASHSCOPE_API_KEY
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional Liquibase migration. Set ADMIN_PASSWORD before running migration.
ADMIN_PASSWORD=YOUR_INITIAL_ADMIN_PASSWORD
# Override when migration uses a different host/user; defaults to DB_* with TLS.
# LIQUIBASE_URL=jdbc:postgresql://YOUR_DB_HOST:5432/postgres?sslmode=require

# Google Web OAuth client ID; use the same value for API and frontend.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
