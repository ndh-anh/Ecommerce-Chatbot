# Database Setup (For Mock Data Sync & API)
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Admin Password
ADMIN_PASSWORD=admin

# RabbitMQ
RABBITMQ_URL=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# Dashscope (Qwen AI for embeddings)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Google Web OAuth client ID; use the same value for API and frontend.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
